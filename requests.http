### Create a user
POST http://localhost:8080/api/v1/users
Content-Type: application/json

{
  "username": "chandana_k",
  "email": "chandana@example.com",
  "password": "temporaryPassword123",
  "role": "USER"
}

###
GET http://localhost:8080/api/v1/users

###
GET http://localhost:8080/api/v1/users/1

###
### Create a project (owned by user with id 1)
POST http://localhost:8080/api/v1/projects
Content-Type: application/json

{
  "name": "Website Redesign",
  "description": "Revamp the company website",
  "owner": {
    "id": 1
  }
}

###
GET http://localhost:8080/api/v1/projects

###
GET http://localhost:8080/api/v1/projects/1

###
### Create a task (in project 1, assigned to user 1)
POST http://localhost:8080/api/v1/tasks
Content-Type: application/json

{
  "title": "Design homepage mockup",
  "description": "Create Figma mockup for new homepage",
  "status": "TODO",
  "project": {
    "id": 1
  },
  "assignee": {
    "id": 1
  }
}

###
### Create an unassigned task (assignee omitted entirely)
POST http://localhost:8080/api/v1/tasks
Content-Type: application/json

{
  "title": "Set up CI/CD pipeline",
  "description": "Configure GitHub Actions",
  "status": "TODO",
  "project": {
    "id": 1
  }
}

###
GET http://localhost:8080/api/v1/tasks

###
GET http://localhost:8080/api/v1/tasks/1

###
### Create a comment (on task 1, by user 1)
POST http://localhost:8080/api/v1/comments
Content-Type: application/json

{
  "content": "Looks great, just fix the header spacing.",
  "task": {
    "id": 1
  },
  "author": {
    "id": 1
  }
}

###
GET http://localhost:8080/api/v1/comments

###
GET http://localhost:8080/api/v1/comments/1

###
POST http://localhost:8080/api/v1/users
Content-Type: application/json

{
  "username": "test_user",
  "email": "test@example.com",
  "password": "mySecret123",
  "role": "USER"
}

###
### Login with correct credentials
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "test_user",
  "password": "mySecret123"
}

###
### Login with wrong password (should fail)
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "test_user",
  "password": "wrongpassword"
}

###
### Login with non-existent username (should fail)
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "does_not_exist",
  "password": "anything"
}

###
### Login (returns JWT token)
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "test_user",
  "password": "mySecret123"
}